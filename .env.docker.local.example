# Copy to .env.docker.local for optional tooling / future env-driven compose.
# Local stack: docker compose -f docker-compose.local.yml up --build
#
# TRAEFIK_NETWORK must match the Docker network your Traefik container uses.
# Docker Compose cannot attach app containers to the default `bridge` network (alias limits).
# Use a user-defined network, e.g.:
#   docker network create traefik
#   docker network connect traefik traefik
#   # add to Traefik command: --providers.docker.network=traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=web
BASE_DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost
